    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.0",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
