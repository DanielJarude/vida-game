ano":2036,"fase":"desaceleracao","inflacao":0.0305,"bolsa":1.1897,"imoveis":1.0984,"juroReal":0.0545},{"ano":2037,"fase":"normal","inflacao":0.0418,"bolsa":1.4971,"imoveis":1.0432,"juroReal":0.0469},{"ano":2038,"fase":"desaceleracao","inflacao":0.0739,"bolsa":1.3184,"imoveis":0.9837,"juroReal":0.0522},{"ano":2039,"fase":"crise","inflacao":0.0688,"bolsa":1.2497,"imoveis":0.893,"juroReal":0.0516},{"ano":2040,"fase":"crise","inflacao":0.0756,"bolsa":1.1819,"imoveis":0.8485,"juroReal":0.0572},{"ano":2041,"fase":"recuperacao","inflacao":0.0535,"bolsa":1.207,"imoveis":0.8939,"juroReal":0.0487},{"ano":2042,"fase":"recuperacao","inflacao":0.0515,"bolsa":1.4149,"imoveis":0.9502,"juroReal":0.0466},{"ano":2043,"fase":"normal","inflacao":0.0515,"bolsa":1.4446,"imoveis":0.9612,"juroReal":0.0414}]},"processos":[],"rotinas":[{"id":"cursinho","tInicio":24505,"nivel":1},{"id":"leitura","tInicio":24505,"nivel":1}],"fatos":{"teve_dengue":2,"frase_perdendo":4,"aviso_concurso":24517},"biografia":[{"id":"e9","t":24313,"idade":0,"texto":"Nasceu em fevereiro de 2026, em Recife, PE, filha de Júlia, auxiliar de limpeza, e Flávio, costureiro.","relevancia":"marco","tema":"nascimento","tom":"bom","pessoas":["p1","p2"]},{"id":"ea","t":24313,"idade":0,"texto":"A irmã Rebeca, de 2 anos, ganhou companhia. Os avós fizeram fila para conhecer a neta. A casa era pequena e o dinheiro, contado.","relevancia":"biografia","tema":"familia","pessoas":["p7"]},{"id":"eb","t":24325,"idade":1,"texto":"Os primeiros passos vieram tarde, depois de muito tempo engatinhando — e vieram de uma vez: atravessou a cozinha sem cair.","relevancia":"marco","tema":"infancia","tom":"bom","pessoas":["p2"]},{"id":"ec","t":24325,"idade":1,"texto":"O avô Alessandro passou a aparecer toda semana, sempre com alguma coisa no bolso para dar escondido.","relevancia":"cotidiano","tema":"familia","pessoas":["p4"]},{"id":"ed","t":24337,"idade":2,"texto":"Sua mãe perdeu o emprego de auxiliar de limpeza. O dinheiro em casa encurtou.","relevancia":"biografia","tema":"familia","tom":"ruim","pessoas":["p1"]},{"id":"ef","t":24337,"idade":2,"texto":"A primeira palavra foi \"não\". A família riu e disse que era um sinal.","relevancia":"marco","tema":"infancia","pessoas":["p2"],"escolha":true},{"id":"eg","t":24349,"idade":3,"texto":"Febre alta, dor atrás dos olhos, manchas pelo corpo: dengue. Foram duas semanas de cama.","relevancia":"biografia","tema":"saude","tom":"ruim"},{"id":"eh","t":24349,"idade":3,"texto":"Sua mãe arrumou trabalho de novo, como encarregada de limpeza.","relevancia":"cotidiano","tema":"familia","pessoas":["p1"]},{"id":"ei","t":24361,"idade":4,"texto":"Entrou na pré-escola, na escola municipal do bairro.","relevancia":"cotidiano","tema":"escola"},{"id":"em","t":24361,"idade":4,"texto":"Uma queda do trepa-trepa terminou com o braço engessado por um mês. O gesso voltou para casa cheio de assinaturas.","relevancia":"biografia","tema":"saude","pessoas":[]},{"id":"et","t":24385,"idade":6,"texto":"Primeiro dia no 1º ano da escola do bairro. Júlia levou até o portão; a professora se chamava Professora Sônia.","relevancia":"marco","tema":"escola","pessoas":["p1"]},{"id":"ew","t":24397,"idade":7,"texto":"Aprendeu a ler no ritmo da turma, juntando sílaba por sílaba no caderno de caligrafia.","relevancia":"biografia","tema":"escola","tom":"neutro","pessoas":[]},{"id":"ex","t":24409,"idade":8,"texto":"Dengue outra vez — e a segunda foi pior que a primeira.","relevancia":"cotidiano","tema":"saude","tom":"ruim"},{"id":"e11","t":24409,"idade":8,"texto":"Vitória virou a amiga de todo dia na rua de casa.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pl"],"evento":{"tipo":"amizade","pessoaId":"pl","peso":20}},{"id":"e12","t":24409,"idade":8,"texto":"O São João de Recife tomou a cidade por duas semanas: forró até de manhã, milho assado e quadrilha na praça.","relevancia":"cotidiano","tema":"lazer","tom":"bom","pessoas":[]},{"id":"e14","t":24409,"idade":8,"texto":"Defendeu Isis de um grupo no corredor da escola.","relevancia":"biografia","tema":"escola","pessoas":["pv"],"escolha":true},{"id":"e16","t":24421,"idade":9,"texto":"Pietro virou o amigo de todo dia na escola.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pp"],"evento":{"tipo":"amizade","pessoaId":"pp","peso":20}},{"id":"e17","t":24421,"idade":9,"texto":"Isis virou a amiga de todo dia na escola.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pv"],"evento":{"tipo":"amizade","pessoaId":"pv","peso":20}},{"id":"e18","t":24421,"idade":9,"texto":"Na festa junina da escola, a professora sorteou os pares da quadrilha: foi com Igor, os dois de roupa xadrez e chapéu de palha.","relevancia":"cotidiano","tema":"escola","pessoas":["po"]},{"id":"e1a","t":24433,"idade":10,"texto":"Benício virou o amigo de todo dia na escola.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pq"],"evento":{"tipo":"amizade","pessoaId":"pq","peso":20}},{"id":"e1b","t":24433,"idade":10,"texto":"Emanuelly virou a amiga de todo dia na rua de casa.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["ps"],"evento":{"tipo":"amizade","pessoaId":"ps","peso":20}},{"id":"e1c","t":24433,"idade":10,"texto":"O aluguel subiu e a família mudou de casa, para uma rua mais longe. Tudo coube numa kombi fretada.","relevancia":"biografia","tema":"lugar","pessoas":[]},{"id":"e1f","t":24445,"idade":11,"texto":"Nasceu sua irmã, Elisa.","relevancia":"marco","tema":"familia","tom":"bom","pessoas":["p1e"]},{"id":"e1l","t":24445,"idade":11,"texto":"Uma chuva de verão alagou a rua e a água entrou em casa. O sofá e a geladeira foram para o lixo.","relevancia":"biografia","tema":"lugar","tom":"ruim","pessoas":[]},{"id":"e1q","t":24457,"idade":12,"texto":"A Copa de 2038 acabou para o Brasil nas oitavas. O bairro inteiro tinha bandeirinha na janela.","relevancia":"cotidiano","tema":"lazer","pessoas":[]},{"id":"e1r","t":24469,"idade":13,"texto":"Seu pai perdeu o emprego de costureiro. O dinheiro em casa encurtou.","relevancia":"biografia","tema":"familia","tom":"ruim","pessoas":["p2"]},{"id":"e1v","t":24469,"idade":13,"texto":"Você e Benício foram se perdendo de vista.","relevancia":"cotidiano","tema":"amizade","pessoas":["pq"]},{"id":"e1w","t":24469,"idade":13,"texto":"As mensagens com Emanuelly foram ficando mais espaçadas, até pararem.","relevancia":"cotidiano","tema":"amizade","pessoas":["ps"]},{"id":"e1x","t":24469,"idade":13,"texto":"O país entrou em recessão. Em casa, a palavra apareceu no jornal da noite e depois na conta do mercado.","relevancia":"biografia","tema":"dinheiro","tom":"ruim","pessoas":[]},{"id":"e1y","t":24481,"idade":14,"texto":"Repetiu o 8º ano do fundamental.","relevancia":"biografia","tema":"escola","tom":"ruim"},{"id":"e1z","t":24481,"idade":14,"texto":"Vitória virou alguém de quem você lembra no aniversário, e só.","relevancia":"cotidiano","tema":"amizade","pessoas":["pl"]},{"id":"e20","t":24481,"idade":14,"texto":"A excursão da escola foi a uma usina hidrelétrica. Na volta, você sentou do lado de Stella no ônibus e conversaram a viagem inteira.","relevancia":"cotidiano","tema":"escola","pessoas":["p1s"]},{"id":"e22","t":24493,"idade":15,"texto":"Seu pai arrumou trabalho de novo, como costureiro.","relevancia":"cotidiano","tema":"familia","pessoas":["p2"]},{"id":"e23","t":24493,"idade":15,"texto":"Na escola, Kauã deixou de ser só colega e virou amigo.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p1g"],"evento":{"tipo":"amizade","pessoaId":"p1g","peso":20}},{"id":"e24","t":24493,"idade":15,"texto":"Na escola, Vanessa deixou de ser só colega e virou amiga.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p1n"],"evento":{"tipo":"amizade","pessoaId":"p1n","peso":20}},{"id":"e27","t":24493,"idade":15,"texto":"A economia voltou a respirar. Os anúncios de vaga reapareceram nos postes.","relevancia":"cotidiano","tema":"dinheiro","pessoas":[]},{"id":"e29","t":24493,"idade":15,"texto":"Chamou Cristiano para sair e levou um não educado.","relevancia":"biografia","tema":"amor","tom":"ruim","pessoas":["p1u"],"escolha":true},{"id":"e2a","t":24505,"idade":16,"texto":"Terminou o fundamental e começou o ensino médio na escola estadual do bairro.","relevancia":"biografia","tema":"escola"},{"id":"e2g","t":24505,"idade":16,"texto":"Na rua de casa, Otávio deixou de ser só colega e virou amigo.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p1k"],"evento":{"tipo":"amizade","pessoaId":"p1k","peso":20}},{"id":"e2i","t":24505,"idade":16,"texto":"A Copa de 2042 acabou para o Brasil nas semifinais. O bairro inteiro tinha bandeirinha na janela.","relevancia":"cotidiano","tema":"lazer","pessoas":[]},{"id":"e2o","t":24517,"idade":17,"texto":"A amizade com Isis ficou para trás, sem briga nenhuma.","relevancia":"cotidiano","tema":"amizade","pessoas":["pv"]},{"id":"e2p","t":24517,"idade":17,"texto":"Saiu o edital para policial rodoviária federal. Os grupos de estudo lotaram.","relevancia":"cotidiano","tema":"trabalho","pessoas":[]},{"id":"e2r","t":24517,"idade":17,"texto":"Chamou Benjamin para sair e levou um não educado.","relevancia":"biografia","tema":"amor","tom":"ruim","pessoas":["p2b"],"escolha":true}],"momento":null,"ocorrencias":[{"id":"bb_primeiros_passos","t":24325,"idade":1},{"id":"bb_visita_avos","t":24325,"idade":1},{"id":"bb_primeira_palavra","t":24337,"idade":2},{"id":"pri_hospital_braco","t":24361,"idade":4},{"id":"inf_primeiro_dia_aula","t":24385,"idade":6},{"id":"inf_alfabetizacao","t":24397,"idade":7},{"id":"mun_sao_joao","t":24409,"idade":8},{"id":"inf_bullying","t":24409,"idade":8},{"id":"inf_festa_junina","t":24421,"idade":9},{"id":"prc_mudanca_bairro","t":24433,"idade":10},{"id":"inf_dever_rua","t":24433,"idade":10},{"id":"inf_enchente","t":24445,"idade":11},{"id":"inf_pet_novo","t":24445,"idade":11},{"id":"adu_copa","t":24457,"idade":12},{"id":"mun_recessao","t":24469,"idade":13},{"id":"ado_excursao","t":24481,"idade":14},{"i