735,"imoveis":1.0851,"juroReal":0.0518},{"ano":2041,"fase":"desaceleracao","inflacao":0.0568,"bolsa":1.1852,"imoveis":1.1323,"juroReal":0.05},{"ano":2042,"fase":"crise","inflacao":0.0841,"bolsa":1.0382,"imoveis":1.1089,"juroReal":0.056},{"ano":2043,"fase":"crise","inflacao":0.0799,"bolsa":0.7992,"imoveis":1.064,"juroReal":0.0581},{"ano":2044,"fase":"recuperacao","inflacao":0.0568,"bolsa":1.0528,"imoveis":1.0687,"juroReal":0.0435}]},"processos":[],"rotinas":[],"fatos":{"frase_perdendo":2,"frase_proximo":1,"saiu_de_casa_p7":24524,"concluiu_medio":24536,"plano_faculdade":24536,"serviu_aeronautica":24536,"primeiro_emprego":24536},"biografia":[{"id":"ec","t":24320,"idade":0,"texto":"Nasceu em setembro de 2026, em Natal, RN, filho de Catarina, pintora de obras, que criou o bebê sem Adriano por perto.","relevancia":"marco","tema":"nascimento","tom":"bom","pessoas":["p1","p2"]},{"id":"ed","t":24320,"idade":0,"texto":"O irmão Samuel, de 3 anos, ganhou companhia. Os avós fizeram fila para conhecer o neto. Em casa, o dinheiro dava para o mês, sem sobra.","relevancia":"biografia","tema":"familia","pessoas":["p7"]},{"id":"ee","t":24332,"idade":1,"texto":"Sua mãe perdeu o emprego de pintora de obras. O dinheiro em casa encurtou.","relevancia":"biografia","tema":"familia","tom":"ruim","pessoas":["p1"]},{"id":"ef","t":24332,"idade":1,"texto":"Deu os primeiros passos na sala, em direção a Catarina. Ela conta essa história até hoje.","relevancia":"marco","tema":"infancia","tom":"bom","pessoas":["p1"]},{"id":"eg","t":24332,"idade":1,"texto":"Uma febre alta de madrugada levou Catarina para a fila da UPA, com o bebê no colo. Era virose; foram atendidos às cinco da manhã.","relevancia":"cotidiano","tema":"saude","pessoas":["p1"]},{"id":"eh","t":24344,"idade":2,"texto":"Seu pai perdeu o emprego de auxiliar de manutenção. O dinheiro em casa encurtou.","relevancia":"biografia","tema":"familia","tom":"ruim","pessoas":["p2"]},{"id":"ej","t":24344,"idade":2,"texto":"A avó Tânia passou a aparecer toda semana, sempre com alguma coisa no bolso para dar escondido.","relevancia":"cotidiano","tema":"familia","pessoas":["p5"]},{"id":"ek","t":24344,"idade":2,"texto":"A primeira palavra foi \"não\". A família riu e disse que era um sinal.","relevancia":"marco","tema":"infancia","pessoas":["p1"],"escolha":true},{"id":"el","t":24356,"idade":3,"texto":"Sua mãe arrumou trabalho de novo, como pintora de obras.","relevancia":"cotidiano","tema":"familia","pessoas":["p1"]},{"id":"em","t":24356,"idade":3,"texto":"Seu pai arrumou trabalho de novo, como técnico de enfermagem.","relevancia":"cotidiano","tema":"familia","pessoas":["p2"]},{"id":"eo","t":24368,"idade":4,"texto":"Entrou na pré-escola, na escola municipal do bairro.","relevancia":"cotidiano","tema":"escola"},{"id":"es","t":24368,"idade":4,"texto":"A primeira vez na praia foi num domingo de sol, com isopor, farofa e Catarina segurando sua mão na beira da água.","relevancia":"biografia","tema":"infancia","tom":"bom","pessoas":["p1"]},{"id":"eu","t":24380,"idade":5,"texto":"O aluguel subiu e a família mudou de casa, para uma rua mais longe. Tudo coube numa kombi fretada.","relevancia":"biografia","tema":"lugar","pessoas":[]},{"id":"e10","t":24392,"idade":6,"texto":"Primeiro dia no 1º ano da escola do bairro. Catarina levou até o portão; a professora se chamava Tia Kátia.","relevancia":"marco","tema":"escola","pessoas":["p1"]},{"id":"e11","t":24392,"idade":6,"texto":"Num sábado de supermercado cheio, você sumiu da vista de Catarina por dez minutos. Chamaram seu nome no alto-falante. Catarina conta essa história com as mãos tremendo até hoje.","relevancia":"biografia","tema":"infancia","pessoas":["p1"]},{"id":"e12","t":24400,"idade":6,"texto":"A cachorra Pretinha morreu em maio, aos 11 anos (problema nos rins). Foram 11 anos juntos. A casa ficou estranha sem o barulho das patas no corredor.","relevancia":"marco","tema":"perda","tom":"ruim","pessoas":["pb"],"evento":{"tipo":"morte","pessoaId":"pb","peso":38}},{"id":"e16","t":24404,"idade":7,"texto":"Aprendeu a ler no ritmo da turma, juntando sílaba por sílaba no caderno de caligrafia.","relevancia":"biografia","tema":"escola","tom":"neutro","pessoas":[]},{"id":"e1b","t":24416,"idade":8,"texto":"Mirella virou a amiga de todo dia na escola.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["py"],"evento":{"tipo":"amizade","pessoaId":"py","peso":20}},{"id":"e1c","t":24428,"idade":9,"texto":"Aurora virou a amiga de todo dia na escola.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p14"],"evento":{"tipo":"amizade","pessoaId":"p14","peso":20}},{"id":"e1d","t":24428,"idade":9,"texto":"A avó Simone passou uma tarde inteira ensinando a jogar dominó, sem deixar ganhar nenhuma vez.","relevancia":"biografia","tema":"familia","pessoas":["p3"]},{"id":"e1e","t":24440,"idade":10,"texto":"João Miguel virou o amigo de todo dia na escola.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pv"],"evento":{"tipo":"amizade","pessoaId":"pv","peso":20}},{"id":"e1f","t":24440,"idade":10,"texto":"Rafael virou o amigo de todo dia na escola.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p13"],"evento":{"tipo":"amizade","pessoaId":"p13","peso":20}},{"id":"e1g","t":24440,"idade":10,"texto":"Uma tempestade parou Natal: avenidas alagadas, ônibus parados, gente dormindo no trabalho.","relevancia":"cotidiano","tema":"lugar","pessoas":[]},{"id":"e1i","t":24440,"idade":10,"texto":"Defendeu Nicole de um grupo no corredor da escola.","relevancia":"biografia","tema":"escola","pessoas":["px"],"escolha":true},{"id":"e1u","t":24476,"idade":13,"texto":"Uma chuva de verão alagou a rua e a água entrou em casa. O sofá e a geladeira foram para o lixo.","relevancia":"biografia","tema":"lugar","tom":"ruim","pessoas":[]},{"id":"e1v","t":24488,"idade":14,"texto":"Na rua de casa, Arthur deixou de ser só colega e virou amigo.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p1a"],"evento":{"tipo":"amizade","pessoaId":"p1a","peso":20}},{"id":"e1w","t":24488,"idade":14,"texto":"Você e Rafael foram se perdendo de vista.","relevancia":"cotidiano","tema":"amizade","pessoas":["p13"]},{"id":"e1z","t":24488,"idade":14,"texto":"A chuva não veio de novo. O açude baixou até aparecer a torre da igreja velha, e a água passou a ser racionada.","relevancia":"cotidiano","tema":"lugar","pessoas":[]},{"id":"e20","t":24500,"idade":15,"texto":"Terminou o fundamental e começou o ensino médio na escola estadual do bairro.","relevancia":"biografia","tema":"escola"},{"id":"e25","t":24500,"idade":15,"texto":"Bernardo passou a ser das pessoas mais próximas da sua vida.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p15"],"evento":{"tipo":"amizade","pessoaId":"p15","peso":35}},{"id":"e26","t":24500,"idade":15,"texto":"As mensagens com João Miguel foram ficando mais espaçadas, até pararem.","relevancia":"cotidiano","tema":"amizade","pessoas":["pv"]},{"id":"e28","t":24500,"idade":15,"texto":"Isis, da sua turma, engravidou aos 15 e parou de ir à escola no segundo semestre.","relevancia":"cotidiano","tema":"escola","pessoas":["p23"]},{"id":"e29","t":24500,"idade":15,"texto":"Chamou Helena para sair e levou um não educado.","relevancia":"biografia","tema":"amor","tom":"ruim","pessoas":["p24"],"escolha":true},{"id":"e2d","t":24512,"idade":16,"texto":"Na rua de casa, Ayla deixou de ser só colega e virou amiga.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p1q"],"evento":{"tipo":"amizade","pessoaId":"p1q","peso":20}},{"id":"e2e","t":24512,"idade":16,"texto":"Na rua de casa, Augusto deixou de ser só colega e virou amigo.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p1t"],"evento":{"tipo":"amizade","pessoaId":"p1t","peso":20}},{"id":"e2g","t":24512,"idade":16,"texto":"O país entrou em recessão: fábricas demitindo, lojas fechando, e as vagas que sobraram pedindo experiência.","relevancia":"biografia","tema":"dinheiro","tom":"ruim","pessoas":[]},{"id":"e2h","t":24524,"idade":17,"texto":"Seu pai perdeu o emprego de técnico de enfermagem. O dinheiro em casa encurtou.","relevancia":"biografia","tema":"familia","tom":"ruim","pessoas":["p2"]},{"id":"e2i","t":24524,"idade":17,"texto":"Samuel saiu de casa. O quarto ficou vazio.","relevancia":"cotidiano","tema":"familia","pessoas":["p7"]},{"id":"e2m","t":24524,"idade":17,"texto":"O São João de Natal tomou a cidade por duas semanas: forró até de manhã, milho assado e quadrilha na praça.","relevancia":"cotidiano","tema":"lazer","tom":"bom","pessoas":[]},{"id":"e2n","t":24536,"idade":18,"texto":"Seu pai arrumou trabalho de novo, como enfermeiro.","relevancia":"cotidiano","tema":"familia","pessoas":["p2"]},{"id":"e2o","t":24536,"idade":18,"texto":"Concluiu o ensino médio.","relevancia":"marco","tema":"escola","tom":"bom"},{"id":"e2r","t":24536,"idade":18,"texto":"A economia voltou a respirar. Os anúncios de vaga reapareceram nos postes.","relevancia":"cotidiano","tema":"dinheiro","pessoas":[]},{"id":"e2s","t":24536,"idade":18,"texto":"Fez o ENEM pela primeira vez e tirou 493 — uma nota baixa.","relevancia":"biografia","tema":"estudo","tom":"ruim","escolha":true},{"id":"e2u","t":24536,"idade":18,"texto":"Mia chegou: uma gata filhote, adotada no abrigo (do abrigo). Curiosa.","relevancia":"biografia","tema":"casa","tom":"bom","pessoas":["p2t"],"escolha":true}],"momento":null,"ocorrencias":[{"id":"bb_primeiros_passos","t":24332,"idade":1},{"id":"bb_febre","t":24332,"idade":1},{"id":"bb_primeira_palavra","t":24344,"idade":2},{"id":"bb_visita_avos","t":24344,"idade":2},{"id":"pri_mentira_doce","t":24356,"idade":3},{"id":"pri_praia","t":24368,"idade":4},{"id":"prc_mudanca_bairro","t":24380,"idade":5},{"id":"inf_primeiro_dia_aula","t":24392,"idade":6},{"id":"pri_perdido","t":24392,"idade":6},{"id":"inf_alfabetizacao","t":24404,"idade":7},{"id":"prc_lanche","t":24404,"idade":7},{"id":"inf_avo_ensina","t":24428,"idade":9},{"id":"mun_chuva_cidade","t":24440,"idade