relevancia":"cotidiano","tema":"infancia","pessoas":["p1"]},{"id":"eh","t":24340,"idade":2,"texto":"Começou a ir para a creche municipal.","relevancia":"cotidiano","tema":"escola"},{"id":"el","t":24340,"idade":2,"texto":"A primeira palavra foi \"não\". A família riu e disse que era um sinal.","relevancia":"marco","tema":"infancia","pessoas":["p2"],"escolha":true},{"id":"en","t":24352,"idade":3,"texto":"Num sábado de supermercado cheio, você sumiu da vista de Natália por dez minutos. Chamaram seu nome no alto-falante. Natália conta essa história com as mãos tremendo até hoje.","relevancia":"biografia","tema":"infancia","pessoas":["p1"]},{"id":"eo","t":24364,"idade":4,"texto":"Entrou na pré-escola, na escola municipal do bairro.","relevancia":"cotidiano","tema":"escola"},{"id":"es","t":24376,"idade":5,"texto":"Nasceu seu irmão, Lorenzo.","relevancia":"marco","tema":"familia","tom":"bom","pessoas":["pr"]},{"id":"e10","t":24388,"idade":6,"texto":"Primeiro dia no 1º ano da escola do bairro. Natália levou até o portão; a professora se chamava Professora Márcia.","relevancia":"marco","tema":"escola","pessoas":["p1"]},{"id":"e11","t":24388,"idade":6,"texto":"Pegou catapora da escola. Duas semanas em casa, coberto de pomada, proibido de coçar.","relevancia":"cotidiano","tema":"saude","pessoas":[]},{"id":"e12","t":24394,"idade":6,"texto":"O cachorro Tobias morreu em novembro, aos 10 anos, de velhice. Foram 10 anos juntos. A casa ficou estranha sem o barulho das patas no corredor.","relevancia":"marco","tema":"perda","tom":"ruim","pessoas":["pc"],"evento":{"tipo":"morte","pessoaId":"pc","peso":38}},{"id":"e16","t":24400,"idade":7,"texto":"A leitura demorou a engrenar. A professora mandou bilhete pedindo reforço em casa.","relevancia":"biografia","tema":"escola","tom":"ruim","pessoas":[]},{"id":"e17","t":24400,"idade":7,"texto":"O país entrou em recessão. Em casa, a palavra apareceu no jornal da noite e depois na conta do mercado.","relevancia":"biografia","tema":"dinheiro","tom":"ruim","pessoas":[]},{"id":"e1b","t":24412,"idade":8,"texto":"Kelly virou a amiga de todo dia na rua de casa.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pu"],"evento":{"tipo":"amizade","pessoaId":"pu","peso":20}},{"id":"e1c","t":24412,"idade":8,"texto":"A economia voltou a respirar. Os anúncios de vaga reapareceram nos postes.","relevancia":"cotidiano","tema":"dinheiro","pessoas":[]},{"id":"e1d","t":24412,"idade":8,"texto":"Em 2034 o Brasil ganhou a Copa. A rua virou festa até de manhã.","relevancia":"cotidiano","tema":"lazer","pessoas":[]},{"id":"e1e","t":24424,"idade":9,"texto":"Isaac virou o amigo de todo dia na escola.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pw"],"evento":{"tipo":"amizade","pessoaId":"pw","peso":20}},{"id":"e1f","t":24436,"idade":10,"texto":"Repetiu o 4º ano do fundamental.","relevancia":"biografia","tema":"escola","tom":"ruim"},{"id":"e1g","t":24436,"idade":10,"texto":"Bernardo virou o amigo de todo dia na escola.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pv"],"evento":{"tipo":"amizade","pessoaId":"pv","peso":20}},{"id":"e1h","t":24436,"idade":10,"texto":"Cecília virou a amiga de todo dia na escola.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p13"],"evento":{"tipo":"amizade","pessoaId":"p13","peso":20}},{"id":"e1i","t":24448,"idade":11,"texto":"O avô Emerson passou uma tarde inteira ensinando a jogar dominó, sem deixar ganhar nenhuma vez.","relevancia":"biografia","tema":"familia","pessoas":["p4"]},{"id":"e1o","t":24460,"idade":12,"texto":"Kelly passou a ser das pessoas mais próximas da sua vida.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pu"],"evento":{"tipo":"amizade","pessoaId":"pu","peso":35}},{"id":"e1p","t":24460,"idade":12,"texto":"Ganhou o primeiro celular: um usado, de tela trincada, que foi de Márcio.","relevancia":"cotidiano","tema":"infancia","pessoas":["p6"]},{"id":"e1q","t":24472,"idade":13,"texto":"Seu pai perdeu o emprego de catador de recicláveis. O dinheiro em casa encurtou.","relevancia":"biografia","tema":"familia","tom":"ruim","pessoas":["p2"]},{"id":"e1r","t":24472,"idade":13,"texto":"Ficou de recuperação em português, e passou raspando.","relevancia":"cotidiano","tema":"escola","tom":"ruim"},{"id":"e1v","t":24472,"idade":13,"texto":"Em algum momento, sem aviso, Jaqueline virou a primeira pessoa para quem você liga.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p15"],"evento":{"tipo":"amizade","pessoaId":"p15","peso":35}},{"id":"e1x","t":24472,"idade":13,"texto":"Rosana, a professora de Português, devolveu uma prova sua com um bilhete: \"você tem jeito para isso\". Ninguém tinha dito aquilo antes.","relevancia":"biografia","tema":"escola","tom":"bom","pessoas":[]},{"id":"e20","t":24484,"idade":14,"texto":"O São João de Salvador tomou a cidade por duas semanas: forró até de manhã, milho assado e quadrilha na praça.","relevancia":"cotidiano","tema":"lazer","tom":"bom","pessoas":[]},{"id":"e21","t":24496,"idade":15,"texto":"Seu pai arrumou trabalho de novo, como estoquista.","relevancia":"cotidiano","tema":"familia","pessoas":["p2"]},{"id":"e22","t":24496,"idade":15,"texto":"Repetiu de ano pela segunda vez, agora no 8º ano do fundamental.","relevancia":"biografia","tema":"escola","tom":"ruim"},{"id":"e24","t":24496,"idade":15,"texto":"Na escola, Pietro deixou de ser só colega e virou amigo.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p1t"],"evento":{"tipo":"amizade","pessoaId":"p1t","peso":20}},{"id":"e25","t":24496,"idade":15,"texto":"Você e Bernardo foram se perdendo de vista.","relevancia":"cotidiano","tema":"amizade","pessoas":["pv"]},{"id":"e28","t":24508,"idade":16,"texto":"Na escola, Enzo deixou de ser só colega e virou amigo.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p1l"],"evento":{"tipo":"amizade","pessoaId":"p1l","peso":20}},{"id":"e29","t":24508,"idade":16,"texto":"As mensagens com Cecília foram ficando mais espaçadas, até pararem.","relevancia":"cotidiano","tema":"amizade","pessoas":["p13"]},{"id":"e2b","t":24508,"idade":16,"texto":"Uma tempestade parou Salvador: avenidas alagadas, ônibus parados, gente dormindo no trabalho.","relevancia":"cotidiano","tema":"lugar","pessoas":[]},{"id":"e2c","t":24520,"idade":17,"texto":"3ª reprovação: o 9º ano do fundamental de novo, com colegas cada vez mais novos.","relevancia":"biografia","tema":"escola","tom":"ruim"},{"id":"e2g","t":24520,"idade":17,"texto":"A excursão da escola foi a um museu na capital. Na volta, você sentou do lado de Priscila no ônibus e conversaram a viagem inteira.","relevancia":"cotidiano","tema":"escola","pessoas":["p1m"]},{"id":"e2h","t":24532,"idade":18,"texto":"Terminou o fundamental e começou o ensino médio na escola estadual do bairro.","relevancia":"biografia","tema":"escola"},{"id":"e2m","t":24532,"idade":18,"texto":"Rosana, que você conheceu na escola, virou amiga de verdade.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p1w"],"evento":{"tipo":"amizade","pessoaId":"p1w","peso":20}},{"id":"e2n","t":24532,"idade":18,"texto":"Isaac virou alguém de quem você lembra no aniversário, e só.","relevancia":"cotidiano","tema":"amizade","pessoas":["pw"]},{"id":"e2p","t":24532,"idade":18,"texto":"Fez o alistamento militar e foi dispensado por excesso de contingente.","relevancia":"cotidiano","tema":"lugar","pessoas":[],"escolha":true},{"id":"e2q","t":24544,"idade":19,"texto":"Seu pai perdeu o emprego de estoquista. O dinheiro em casa encurtou.","relevancia":"biografia","tema":"familia","tom":"ruim","pessoas":["p2"]},{"id":"e2r","t":24544,"idade":19,"texto":"Seus pais se separaram depois de décadas juntos.","relevancia":"marco","tema":"familia","tom":"ruim","pessoas":["p1","p2"],"evento":{"tipo":"ruptura","peso":30}},{"id":"e2t","t":24544,"idade":19,"texto":"Isabella casou com Leonardo.","relevancia":"cotidiano","tema":"familia","tom":"bom","pessoas":["p7"]},{"id":"e2x","t":24544,"idade":19,"texto":"Levaram seu celular num assalto rápido, à luz do dia, numa esquina movimentada.","relevancia":"biografia","tema":"lugar","tom":"ruim","pessoas":[]},{"id":"e2y","t":24556,"idade":20,"texto":"Seu pai arrumou trabalho de novo, como estoquista.","relevancia":"cotidiano","tema":"familia","pessoas":["p2"]},{"id":"e30","t":24556,"idade":20,"texto":"Esther casou com Felipe.","relevancia":"cotidiano","tema":"familia","tom":"bom","pessoas":["p8"]},{"id":"e31","t":24556,"idade":20,"texto":"Esther saiu de casa. O quarto ficou vazio.","relevancia":"cotidiano","tema":"familia","pessoas":["p8"]},{"id":"e34","t":24556,"idade":20,"texto":"O avô cobriu R$ 1.500 do buraco do ano.","relevancia":"cotidiano","tema":"familia","tom":"bom","pessoas":["p4"]},{"id":"e36","t":24568,"idade":21,"texto":"4ª reprovação: a 3ª série do ensino médio de novo, com colegas cada vez mais novos.","relevancia":"biografia","tema":"escola","tom":"ruim"},{"id":"e37","t":24568,"idade":21,"texto":"Jaqueline se mudou para Palmas. A amizade passou a caber no celular.","relevancia":"biografia","tema":"amizade","pessoas":["p15"]},{"id":"e38","t":24568,"idade":21,"texto":"Ryan, que você conheceu no ensino médio, virou amigo de verdade.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p2u"],"evento":{"tipo":"amizade","pessoaId":"p2u","peso":20}},{"id":"e39","t":24568,"idade":21,"texto":"A amizade com Enzo ficou para trás, sem briga nenhuma.","relevancia":"cotidiano","tema":"amizade","pessoas":["p1l"]},{"id":"e3d","t":24568,"idade":21,"texto":"Começou a sair com Theo.","relevancia":"biografia","tema":"amor","tom":"bom","pessoas":["p2v"],"escolha":true},{"id":"e3e","t":24580,"idade":22,"texto":"Concluiu o ensino médio, com 4 repetências no caminho.","relevancia":"marco","tema":"escola","tom":"bom"},{"id":"e3h","t":24580,"idade":22,"texto":"Começou a namorar Theo.","relevancia":"marco","tema":"amor","tom":"bom","pessoas":["p2v"],"escolha":true},{"id":"e3i","t":24592,"idade":23,"texto":"Sua avó Sabrina ficou internada por uns dias. Voltou para casa mais devagar.","relevancia":"cotidiano","tema":"familia","tom":"ruim","pessoas":["p5"]},{"id":"e3j","t":24592,"idade":23,"texto":"Isabella saiu de casa. O quarto ficou vazio.","relevancia":"cotidiano","tema":"familia","pessoas":["p7"]},{"id":"e3k","t":24592,"idade":23,"texto":"Theo atravessou uma fase difícil: ele ficou calado, distante, com a cabeça longe.","relevancia":"cotidiano","tema":"amor","tom":"ruim","pessoas":["p2v"]},{"id":"e3m","t":24592,"idade":23,"texto":"Reencontrou Bernardo depois de anos.","relevancia":"biografia","tema":"amizade","pessoas":["pv"],"escolha":true,"evento":{"tipo":"reencontro","pessoaId":"pv","peso":20}},{"id":"e3n","t":24604,"idade":24,"texto":"Você e Pietro deixaram de combinar coisas. Ninguém percebeu quando.","relevancia":"cotidiano","tema":"amizade","pessoas":["p1t"]},{"id":"e3o","t":24604,"idade":24,"texto":"Você e Rosana foram se perdendo de vista.","relevancia":"cotidiano","tema":"amizade","pessoas":["p1w"]},{"id":"e3p","t":24604,"idade":24,"texto":"Kelly se formou — primeira da família. Você gritou o nome dela da plateia.","relevancia":"cotidiano","tema":"amizade","pessoas":["pu"]},{"id":"e3q","t":24616,"idade":25,"texto":"As mensagens com Ryan foram ficando mais espaçadas, até pararem.","relevancia":"cotidiano","tema":"amizade","pessoas":["p2u"]},{"id":"e3t","t":24616,"idade":25,"texto":"Uma chuva de verão alagou a rua e a água entrou em casa. O sofá e a geladeira foram para o lixo.","relevancia":"biografia","tema":"lugar","tom":"ruim","pessoas":[]},{"id":"e3v","t":24628,"idade":26,"texto":"Lorenzo saiu de casa. O quarto ficou vazio.","relevancia":"cotidiano","tema":"familia","pessoas":["pr"]},{"id":"e3x","t":24637,"idade":26,"texto":"Seu avô Márcio morreu, aos 77 anos (câncer).","relevancia":"marco","tema":"perda","tom":"ruim","pessoas":["p6"],"evento":{"tipo":"morte","pessoaId":"p6","peso":46}},{"id":"e3y","t":24640,"idade":27,"texto":"Morreu 