faculdade":24537,"ajudou_p4":24573,"ajudas_recebidas":2,"frase_amigo_mudou":1,"primeiro_emprego":24705,"frase_distancia":1,"ajudou_p2":24717},"biografia":[{"id":"e8","t":24321,"idade":0,"texto":"Nasceu em outubro de 2026, em Belo Horizonte, MG, filha de Luciano, estoquista, que ficou com a criação quando Aurora foi embora.","relevancia":"marco","tema":"nascimento","tom":"bom","pessoas":["p1","p2"]},{"id":"e9","t":24321,"idade":0,"texto":"Os avós fizeram fila para conhecer a neta. A casa era pequena e o dinheiro, contado.","relevancia":"biografia","tema":"familia","pessoas":[]},{"id":"ea","t":24333,"idade":1,"texto":"Os primeiros passos vieram tarde, depois de muito tempo engatinhando — e vieram de uma vez: atravessou a cozinha sem cair.","relevancia":"marco","tema":"infancia","tom":"bom","pessoas":["p2"]},{"id":"eb","t":24345,"idade":2,"texto":"O avô Sérgio passou a aparecer toda semana, sempre com alguma coisa no bolso para dar escondido.","relevancia":"cotidiano","tema":"familia","pessoas":["p4"]},{"id":"ed","t":24345,"idade":2,"texto":"A primeira palavra foi \"não\". A família riu e disse que era um sinal.","relevancia":"marco","tema":"infancia","pessoas":["p2"],"escolha":true},{"id":"ee","t":24369,"idade":4,"texto":"Entrou na pré-escola, na escola municipal do bairro.","relevancia":"cotidiano","tema":"escola"},{"id":"ek","t":24381,"idade":5,"texto":"Uma tempestade parou Belo Horizonte: avenidas alagadas, ônibus parados, gente dormindo no trabalho.","relevancia":"cotidiano","tema":"lugar","pessoas":[]},{"id":"eq","t":24393,"idade":6,"texto":"Francisco virou o amigo de todo dia na rua de casa.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["ph"],"evento":{"tipo":"amizade","pessoaId":"ph","peso":20}},{"id":"er","t":24393,"idade":6,"texto":"Primeiro dia no 1º ano da escola do bairro. Luciano levou até o portão; a professora se chamava Tia Kátia.","relevancia":"marco","tema":"escola","pessoas":["p2"]},{"id":"es","t":24393,"idade":6,"texto":"Num sábado de supermercado cheio, você sumiu da vista de Luciano por dez minutos. Chamaram seu nome no alto-falante. Luciano conta essa história com as mãos tremendo até hoje.","relevancia":"biografia","tema":"infancia","pessoas":["p2"]},{"id":"eu","t":24393,"idade":6,"texto":"Quebrou o vaso de Mariana e contou na hora.","relevancia":"biografia","tema":"familia","pessoas":["p5"],"escolha":true},{"id":"ey","t":24405,"idade":7,"texto":"Aprendeu a ler no ritmo da turma, juntando sílaba por sílaba no caderno de caligrafia.","relevancia":"biografia","tema":"escola","tom":"neutro","pessoas":[]},{"id":"ez","t":24405,"idade":7,"texto":"Uma queda do trepa-trepa terminou com o braço engessado por um mês. O gesso voltou para casa cheio de assinaturas.","relevancia":"biografia","tema":"saude","pessoas":[]},{"id":"e11","t":24405,"idade":7,"texto":"Chamou Igor, que estava sozinho no primeiro dia, para brincar.","relevancia":"biografia","tema":"amizade","pessoas":["pl"],"escolha":true},{"id":"e14","t":24417,"idade":8,"texto":"Igor virou o amigo de todo dia na escola.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pl"],"evento":{"tipo":"amizade","pessoaId":"pl","peso":20}},{"id":"e15","t":24417,"idade":8,"texto":"A família de Francisco se mudou para outra cidade. A despedida foi no portão da escola.","relevancia":"biografia","tema":"amizade","tom":"ruim","pessoas":["ph"]},{"id":"e16","t":24429,"idade":9,"texto":"Luan virou o amigo de todo dia na escola.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pm"],"evento":{"tipo":"amizade","pessoaId":"pm","peso":20}},{"id":"e17","t":24429,"idade":9,"texto":"Na festa junina da escola, a professora sorteou os pares da quadrilha: foi com Lucas, os dois de roupa xadrez e chapéu de palha.","relevancia":"cotidiano","tema":"escola","pessoas":["p13"]},{"id":"e19","t":24441,"idade":10,"texto":"Noah virou o amigo de todo dia na escola.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pn"],"evento":{"tipo":"amizade","pessoaId":"pn","peso":20}},{"id":"e1a","t":24441,"idade":10,"texto":"Vicente virou o amigo de todo dia na rua de casa.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pp"],"evento":{"tipo":"amizade","pessoaId":"pp","peso":20}},{"id":"e1f","t":24453,"idade":11,"texto":"Na escola, Sophia deixou de ser só colega e virou amiga.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pw"],"evento":{"tipo":"amizade","pessoaId":"pw","peso":20}},{"id":"e1g","t":24453,"idade":11,"texto":"Você e Francisco foram se perdendo de vista.","relevancia":"cotidiano","tema":"amizade","pessoas":["ph"]},{"id":"e1k","t":24465,"idade":12,"texto":"Uma chuva de verão alagou a rua e a água entrou em casa. O sofá e a geladeira foram para o lixo.","relevancia":"biografia","tema":"lugar","tom":"ruim","pessoas":[]},{"id":"e1o","t":24477,"idade":13,"texto":"Vicente passou a ser das pessoas mais próximas da sua vida.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pp"],"evento":{"tipo":"amizade","pessoaId":"pp","peso":35}},{"id":"e1q","t":24477,"idade":13,"texto":"Aline, a professora de Biologia, devolveu uma prova sua com um bilhete: \"você tem jeito para isso\". Ninguém tinha dito aquilo antes.","relevancia":"biografia","tema":"escola","tom":"bom","pessoas":[]},{"id":"e1s","t":24489,"idade":14,"texto":"Na rua de casa, Miguel deixou de ser só colega e virou amigo.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["px"],"evento":{"tipo":"amizade","pessoaId":"px","peso":20}},{"id":"e1t","t":24489,"idade":14,"texto":"As mensagens com Noah foram ficando mais espaçadas, até pararem.","relevancia":"cotidiano","tema":"amizade","pessoas":["pn"]},{"id":"e1v","t":24489,"idade":14,"texto":"A excursão da escola foi a um parque aquático. Na volta, você sentou do lado de Kauã no ônibus e conversaram a viagem inteira.","relevancia":"cotidiano","tema":"escola","pessoas":["p1i"]},{"id":"e1x","t":24489,"idade":14,"texto":"Chamou Pedro para sair e levou um não educado.","relevancia":"biografia","tema":"amor","tom":"ruim","pessoas":["p1n"],"escolha":true},{"id":"e1y","t":24501,"idade":15,"texto":"Terminou o fundamental e começou o ensino médio na escola estadual do bairro.","relevancia":"biografia","tema":"escola"},{"id":"e24","t":24501,"idade":15,"texto":"Na escola, Benjamin deixou de ser só colega e virou amigo.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p1d"],"evento":{"tipo":"amizade","pessoaId":"p1d","peso":20}},{"id":"e25","t":24501,"idade":15,"texto":"Sophia virou alguém de quem você lembra no aniversário, e só.","relevancia":"cotidiano","tema":"amizade","pessoas":["pw"]},{"id":"e29","t":24513,"idade":16,"texto":"A amizade com Luan ficou para trás, sem briga nenhuma.","relevancia":"cotidiano","tema":"amizade","pessoas":["pm"]},{"id":"e2c","t":24516,"idade":16,"texto":"Seu amigo Igor morreu aos 18 anos (infarto). Eram amigos desde 2032, quando se conheceram na escola.","relevancia":"cotidiano","tema":"perda","tom":"ruim","pessoas":["pl"],"evento":{"tipo":"morte","pessoaId":"pl","peso":27}},{"id":"e2f","t":24525,"idade":17,"texto":"Saiu o edital para policial rodoviária federal. Os grupos de estudo lotaram.","relevancia":"cotidiano","tema":"trabalho","pessoas":[]},{"id":"e2g","t":24537,"idade":18,"texto":"Concluiu o ensino médio.","relevancia":"marco","tema":"escola","tom":"bom"},{"id":"e2j","t":24537,"idade":18,"texto":"Fez o ENEM pela primeira vez e tirou 591 — uma nota mediana.","relevancia":"biografia","tema":"estudo","tom":"neutro","escolha":true},{"id":"e2k","t":24549,"idade":19,"texto":"Sua mãe perdeu o emprego de trabalhadora doméstica. O dinheiro em casa encurtou.","relevancia":"biografia","tema":"familia","tom":"ruim","pessoas":["p1"]},{"id":"e2l","t":24549,"idade":19,"texto":"Você e Benjamin deixaram de combinar coisas. Ninguém percebeu quando.","relevancia":"cotidiano","tema":"amizade","pessoas":["p1d"]},{"id":"e2n","t":24561,"idade":20,"texto":"Sua mãe arrumou trabalho de novo, como trabalhadora doméstica.","relevancia":"cotidiano","tema":"familia","pessoas":["p1"]},{"id":"e2p","t":24561,"idade":20,"texto":"Levaram seu celular num assalto rápido, à luz do dia, numa esquina movimentada.","relevancia":"biografia","tema":"lugar","tom":"ruim","pessoas":[]},{"id":"e2q","t":24570,"idade":20,"texto":"Seu avô Antônio morreu, aos 75 anos (câncer).","relevancia":"marco","tema":"perda","tom":"ruim","pessoas":["p6"],"evento":{"tipo":"morte","pessoaId":"p6","peso":45}},{"id":"e2s","t":24573,"idade":21,"texto":"O avô cobriu R$ 1.500 do buraco do ano.","relevancia":"cotidiano","tema":"familia","tom":"bom","pessoas":["p4"]},{"id":"e2w","t":24597,"idade":23,"texto":"Você e Miguel foram se perdendo de vista.","relevancia":"cotidiano","tema":"amizade","pessoas":["px"]},{"id":"e2x","t":24609,"idade":24,"texto":"Seu avô Sérgio ficou internado por uns dias. Voltou para casa mais devagar.","relevancia":"cotidiano","tema":"familia","tom":"ruim","pessoas":["p4"]},{"id":"e2y","t":24609,"idade":24,"texto":"Vicente se mudou para Recife. A amizade passou a caber no celular.","relevancia":"biografia","tema":"amizade","pessoas":["pp"]},{"id":"e31","t":24624,"idade":25,"texto":"Seu avô Sérgio morreu, aos 78 anos (AVC).","relevancia":"marco","tema":"perda","tom":"ruim","pessoas":["p4"],"evento":{"tipo":"morte","pessoaId":"p4","peso":51}},{"id":"e32","t":24633,"idade":26,"texto":"O almoço de Páscoa juntou a família toda pela primeira vez em anos, na casa de Luciano.","relevancia":"cotidiano","tema":"familia","pessoas":["p2"]},{"id":"e33","t":24645,"idade":27,"texto":"Uma tempestade parou Belo Horizonte: avenidas alagadas, ônibus parados, gente dormindo no trabalho.","relevancia":"cotidiano","tema":"lugar","pessoas":[]},{"id":"e36","t":24657,"idade":28,"texto":"Vicente se formou — primeiro da família. Você gritou o nome dele da plateia.","relevancia":"cotidiano","tema":"amizade","pessoas":["pp"]},{"id":"e38","t":24657,"idade":28,"texto":"Reencontrou Francisco depois de anos.","relevancia":"biografia","tema":"amizade","pessoas":["ph"],"escolha":true,"evento":{"tipo":"reencontro","pessoaId":"ph","peso":20}},{"id":"e39","t":24669,"idade":29,"texto":"Sua avó Thaís ficou internada por uns dias. Voltou para casa mais devagar.","relevancia":"cotidiano","tema":"familia","tom":"ruim","pessoas":["p3"]},{"id":"e3b","t":24669,"idade":29,"texto":"Saiu o edital para agente comunitária de saúde. Os grupos de estudo lotaram.","relevancia":"cotidiano","tema":"trabalho","pessoas":[]},{"id":"e3c","t":24677,"idade":29,"texto":"Sua avó Thaís morreu, aos 81 anos (câncer).","relevancia":"marco","tema":"perda","tom":"ruim","pessoas":["p3"],"evento":{"tipo":"morte","pessoaId":"p3","peso":47}},{"id":"e3d","t":24681,"idade":30,"texto":"Esbarrou em Miguel numa festa de aniversário. Anos sem se ver; conversaram como se tivesse sido ontem, e trocaram telefone.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["px"]},{"id":"e3f","t":24692,"idade":30,"texto":"Francisco, que você conheceu por aí, morreu aos 33 anos (infarto).","relevancia":"cotidiano","tema":"perda","tom":"ruim","pessoas":["ph"],"evento":{"tipo":"morte","pessoaId":"ph","peso":17}},{"id":"e3g","t":24693,"idade":31,"texto":"Concluiu o mestrado.","relevancia":"marco","tema":"estudo","tom":"bom"},{"id":"e3h","t":24693,"idade":31,"texto":"Vicente teve uma filha. As mensagens no grupo passaram a ser fotos de bebê.","relevancia":"cotidiano","tema":"amizade","pessoas":["pp"]},{"id":"e3i","t":24705,"idade":32,"texto":"Concluiu o doutorado.","relevancia":"marco","tema":"estudo","tom":"bom"},{"id":"e3j","t":24705,"idade":32,"texto":"Levaram sua carteira num arrastão perto do terminal.","relevancia":"biografia","tema":"lugar","tom":"ruim","pessoas":[]},{"id":"e3l","t":24716,"idade":32,"texto":"Sua avó Mariana morreu, aos 78 anos (infarto).","relevancia":"marco","tema":"perda","tom":"ruim","pessoas":["p5"],"evento":{"tipo":"morte","pessoaId":"p5","peso":49}},{"id":"e3p","t"