sta_de_p1c":24722,"recusou_ilicito":24722},"biografia":[{"id":"e8","t":24314,"idade":0,"texto":"Nasceu em março de 2026, em Salvador, BA, filha de Aline, do lar, e Severino, médico especialista.","relevancia":"marco","tema":"nascimento","tom":"bom","pessoas":["p1","p2"]},{"id":"e9","t":24314,"idade":0,"texto":"O irmão Guilherme, de 5 anos, ganhou companhia. Os avós fizeram fila para conhecer a neta. A família tinha dinheiro de sobra.","relevancia":"biografia","tema":"familia","pessoas":["p6"]},{"id":"ea","t":24326,"idade":1,"texto":"Os primeiros passos vieram tarde, depois de muito tempo engatinhando — e vieram de uma vez: atravessou a cozinha sem cair.","relevancia":"marco","tema":"infancia","tom":"bom","pessoas":["p2"]},{"id":"eb","t":24326,"idade":1,"texto":"Foi um bebê de noites curtas. Severino diz que passou um ano inteiro dormindo em prestações.","relevancia":"cotidiano","tema":"infancia","pessoas":["p2"]},{"id":"ec","t":24338,"idade":2,"texto":"Começou a ir para uma escola particular.","relevancia":"cotidiano","tema":"escola"},{"id":"ef","t":24338,"idade":2,"texto":"A avó Zilda passou a aparecer toda semana, sempre com alguma coisa no bolso para dar escondido.","relevancia":"cotidiano","tema":"familia","pessoas":["p5"]},{"id":"eh","t":24338,"idade":2,"texto":"A primeira palavra foi \"não\". A família riu e disse que era um sinal.","relevancia":"marco","tema":"infancia","pessoas":["p2"],"escolha":true},{"id":"ej","t":24350,"idade":3,"texto":"Severino pagou uma sessão de fotos num estúdio do centro. A foto emoldurada ficou na parede da sala por anos.","relevancia":"cotidiano","tema":"familia","pessoas":["p2"]},{"id":"ek","t":24362,"idade":4,"texto":"Entrou na pré-escola, numa escola particular.","relevancia":"cotidiano","tema":"escola"},{"id":"en","t":24370,"idade":4,"texto":"Sua avó Sebastiana morreu, aos 66 anos (pneumonia).","relevancia":"marco","tema":"perda","tom":"ruim","pessoas":["p3"],"evento":{"tipo":"morte","pessoaId":"p3","peso":39}},{"id":"eo","t":24374,"idade":5,"texto":"Seu pai perdeu o emprego de médico especialista. O dinheiro em casa encurtou.","relevancia":"biografia","tema":"familia","tom":"ruim","pessoas":["p2"]},{"id":"es","t":24386,"idade":6,"texto":"Seu pai arrumou trabalho de novo, como médico especialista.","relevancia":"cotidiano","tema":"familia","pessoas":["p2"]},{"id":"ex","t":24386,"idade":6,"texto":"Primeiro dia no 1º ano, de uniforme novo e mochila maior que as costas. Severino ficou no portão até a porta da sala fechar.","relevancia":"marco","tema":"escola","pessoas":["p2"]},{"id":"ez","t":24386,"idade":6,"texto":"Quebrou o vaso de Zilda e contou na hora.","relevancia":"biografia","tema":"familia","pessoas":["p5"],"escolha":true},{"id":"e13","t":24398,"idade":7,"texto":"Aprendeu a ler no ritmo da turma, juntando sílaba por sílaba no caderno de caligrafia.","relevancia":"biografia","tema":"escola","tom":"neutro","pessoas":[]},{"id":"e14","t":24398,"idade":7,"texto":"No Natal, Cícero se vestiu de Papai Noel com barba de algodão. Todo mundo fingiu não reconhecer.","relevancia":"cotidiano","tema":"familia","tom":"bom","pessoas":["p4"]},{"id":"e17","t":24410,"idade":8,"texto":"O país entrou em recessão. Em casa, a palavra apareceu no jornal da noite e depois na conta do mercado.","relevancia":"biografia","tema":"dinheiro","tom":"ruim","pessoas":[]},{"id":"e18","t":24410,"idade":8,"texto":"O São João de Salvador tomou a cidade por duas semanas: forró até de manhã, milho assado e quadrilha na praça.","relevancia":"cotidiano","tema":"lazer","tom":"bom","pessoas":[]},{"id":"e19","t":24422,"idade":9,"texto":"Noah virou o amigo de todo dia na rua de casa.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pm"],"evento":{"tipo":"amizade","pessoaId":"pm","peso":20}},{"id":"e1a","t":24422,"idade":9,"texto":"Heloísa virou a amiga de todo dia na escola.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pu"],"evento":{"tipo":"amizade","pessoaId":"pu","peso":20}},{"id":"e1b","t":24422,"idade":9,"texto":"A economia voltou a respirar. Os anúncios de vaga reapareceram nos postes.","relevancia":"cotidiano","tema":"dinheiro","pessoas":[]},{"id":"e1i","t":24446,"idade":11,"texto":"A excursão da escola foi a um sítio arqueológico. Na volta, você sentou do lado de Pietro no ônibus e conversaram a viagem inteira.","relevancia":"cotidiano","tema":"escola","pessoas":["p1f"]},{"id":"e1m","t":24458,"idade":12,"texto":"Na rua de casa, Benjamin deixou de ser só colega e virou amigo.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p12"],"evento":{"tipo":"amizade","pessoaId":"p12","peso":20}},{"id":"e1n","t":24458,"idade":12,"texto":"Uma tempestade parou Salvador: avenidas alagadas, ônibus parados, gente dormindo no trabalho.","relevancia":"cotidiano","tema":"lugar","pessoas":[]},{"id":"e1o","t":24470,"idade":13,"texto":"Ficou de recuperação em matemática, e passou raspando.","relevancia":"cotidiano","tema":"escola","tom":"ruim"},{"id":"e1s","t":24470,"idade":13,"texto":"Ganhou o primeiro celular de Severino, com uma lista de regras que durou uma semana.","relevancia":"cotidiano","tema":"infancia","pessoas":["p2"]},{"id":"e1v","t":24482,"idade":14,"texto":"Noah passou a ser das pessoas mais próximas da sua vida.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pm"],"evento":{"tipo":"amizade","pessoaId":"pm","peso":35}},{"id":"e1w","t":24482,"idade":14,"texto":"Na escola, Pietro deixou de ser só colega e virou amigo.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p1f"],"evento":{"tipo":"amizade","pessoaId":"p1f","peso":20}},{"id":"e1z","t":24494,"idade":15,"texto":"Sua avó Zilda ficou internada por uns dias. Voltou para casa mais devagar.","relevancia":"cotidiano","tema":"familia","tom":"ruim","pessoas":["p5"]},{"id":"e21","t":24494,"idade":15,"texto":"Guilherme casou com Rosana.","relevancia":"cotidiano","tema":"familia","tom":"bom","pessoas":["p6"]},{"id":"e22","t":24494,"idade":15,"texto":"Terminou o fundamental e começou o ensino médio num colégio particular.","relevancia":"biografia","tema":"escola"},{"id":"e27","t":24494,"idade":15,"texto":"Na rua de casa, Olívia deixou de ser só colega e virou amiga.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p1c"],"evento":{"tipo":"amizade","pessoaId":"p1c","peso":20}},{"id":"e28","t":24499,"idade":15,"texto":"Seu avô Cícero morreu, aos 81 anos (pneumonia).","relevancia":"marco","tema":"perda","tom":"ruim","pessoas":["p4"],"evento":{"tipo":"morte","pessoaId":"p4","peso":40}},{"id":"e2b","t":24506,"idade":16,"texto":"Você e Bernardo foram se perdendo de vista.","relevancia":"cotidiano","tema":"amizade","pessoas":["pw"]},{"id":"e2c","t":24506,"idade":16,"texto":"Paula, da sua turma, engravidou aos 15 e parou de ir à escola no segundo semestre.","relevancia":"cotidiano","tema":"escola","pessoas":["p26"]},{"id":"e2d","t":24518,"idade":17,"texto":"Sua avó Zilda morreu, aos 83 anos (câncer).","relevancia":"marco","tema":"perda","tom":"ruim","pessoas":["p5"],"evento":{"tipo":"morte","pessoaId":"p5","peso":46}},{"id":"e2g","t":24518,"idade":17,"texto":"O país voltou a entrar em recessão: fábricas demitindo, lojas fechando, e as vagas que sobraram pedindo experiência.","relevancia":"biografia","tema":"dinheiro","tom":"ruim","pessoas":[]},{"id":"e2i","t":24518,"idade":17,"texto":"Começou a sair com Martin.","relevancia":"biografia","tema":"amor","tom":"bom","pessoas":["p29"],"escolha":true},{"id":"e2j","t":24530,"idade":18,"texto":"Guilherme e Rosana se separaram. Ele passou uns tempos mal.","relevancia":"biografia","tema":"familia","tom":"ruim","pessoas":["p6"]},{"id":"e2k","t":24530,"idade":18,"texto":"Ficou de recuperação em matemática, e passou raspando.","relevancia":"cotidiano","tema":"escola","tom":"ruim"},{"id":"e2l","t":24530,"idade":18,"texto":"Concluiu o ensino médio.","relevancia":"marco","tema":"escola","tom":"bom"},{"id":"e2m","t":24530,"idade":18,"texto":"As mensagens com Pietro foram ficando mais espaçadas, até pararem.","relevancia":"cotidiano","tema":"amizade","pessoas":["p1f"]},{"id":"e2o","t":24530,"idade":18,"texto":"Fez o ENEM pela primeira vez e tirou 518 — uma nota baixa.","relevancia":"biografia","tema":"estudo","tom":"neutro","escolha":true},{"id":"e2p","t":24542,"idade":19,"texto":"As saídas com Martin foram rareando até pararem.","relevancia":"cotidiano","tema":"amor","pessoas":["p29"]},{"id":"e2q","t":24542,"idade":19,"texto":"A crise foi passando sem aviso: o shopping encheu de novo, as obras paradas voltaram a ter barulho.","relevancia":"cotidiano","tema":"dinheiro","pessoas":[]},{"id":"e2r","t":24554,"idade":20,"texto":"Levaram seu celular num assalto rápido, à luz do dia, numa esquina movimentada.","relevancia":"biografia","tema":"lugar","tom":"ruim","pessoas":[]},{"id":"e2s","t":24566,"idade":21,"texto":"Olívia virou alguém de quem você lembra no aniversário, e só.","relevancia":"cotidiano","tema":"amizade","pessoas":["p1c"]},{"id":"e2t","t":24566,"idade":21,"texto":"O São João de Salvador tomou a cidade por duas semanas: forró até de manhã, milho assado e quadrilha na praça.","relevancia":"cotidiano","tema":"lazer","tom":"bom","pessoas":[]},{"id":"e2u","t":24578,"idade":22,"texto":"Guilherme saiu de casa. O quarto ficou vazio.","relevancia":"cotidiano","tema":"familia","pessoas":["p6"]},{"id":"e2v","t":24578,"idade":22,"texto":"A amizade com Benjamin ficou para trás, sem briga nenhuma.","relevancia":"cotidiano","tema":"amizade","pessoas":["p12"]},{"id":"e2x","t":24578,"idade":22,"texto":"Uma tempestade parou Salvador: avenidas alagadas, ônibus parados, gente dormindo no trabalho.","relevancia":"cotidiano","tema":"lugar","pessoas":[]},{"id":"e2z","t":24590,"idade":23,"texto":"Saiu o edital para técnica administrativa concursada. Os grupos de estudo lotaram.","relevancia":"cotidiano","tema":"trabalho","pessoas":[]},{"id":"e31","t":24590,"idade":23,"texto":"Caiu no golpe do falso atendente e perdeu R$ 2.037.","relevancia":"biografia","tema":"dinheiro","tom":"ruim","pessoas":[],"escolha":true},{"id":"e32","t":24602,"idade":24,"texto":"Febre alta, dor atrás dos olhos, manchas pelo corpo: dengue. Foram duas semanas de cama.","relevancia":"biografia","tema":"saude","tom":"ruim"},{"id":"e33","t":24602,"idade":24,"texto":"O pai cobriu R$ 5.500 do buraco do ano.","relevancia":"cotidiano","tema":"familia","tom":"bom","pessoas":["p2"]},{"id":"e35","t":24602,"idade":24,"texto":"O país voltou a entrar em recessão: fábricas demitindo, lojas fechando, e as vagas que sobraram pedindo experiência.","relevancia":"biografia","tema":"dinheiro","tom":"ruim","pessoas":[]},{"id":"e36","t":24614,"idade":25,"texto":"A fatura do cartão ficou sem pagar e o nome foi parar no cadastro de devedores.","relevancia":"biografia","tema":"dinheiro","tom":"ruim"},{"id":"e37","t":24614,"idade":25,"texto":"De novo, o irmão, Guilherme, ajudou a fechar as contas: R$ 500.","relevancia":"cotidiano","tema":"familia","tom":"bom","pessoas":["p6"]},{"id":"e38","t":24626,"idade":26,"texto":"Seu pai se aposentou.","relevancia":"cotidiano","tema":"familia","pessoas":["p2"]},{"id":"e3a","t":24626,"idade":26,"texto":"O jornal anunciou o fim da recessão. Na rua, a notícia chegou em forma de \"contrata-se\" na vitrine.","relevancia":"cotidiano","tema":"dinheiro","pessoas":[]},{"id":"e3c","t":24638,"idade":27,"texto":"O pai mandou R$ 5.500 \"para ajudar\", sem perguntar muito.","relevancia":"tecnico","tema":"familia","tom":"bom","pessoas":["p2"]},{"id":"e3d","t":24638,"idade":27,"texto":"O São João de Salvador tomou a cidade por duas semanas: forró até de manhã, milho assado e quadrilha na praça.","relevancia":"cotidiano","tema":"lazer","tom":"bom","pessoas":[]},{"id":"e3f","t":24650,"idade":28,"texto":"Sua mãe se aposentou.","relevancia":"cotidiano","tema":"familia","pessoas":["p1"]},{"id":"e3g","t":24650,"idade":28,"texto":"A mãe cobriu R$ 300 do buraco do ano.","relevancia":"tecnico","tema":"familia","tom":"bom","pessoas":["p1"]},{"id":"e3h","t":24650,"idade":28,"texto":"A Copa de 2054 acabou para o Brasil nas semifinais. O bairro inteiro tinha bandeirinha na janela.","relevancia":"cotidiano","tema":"lazer","pessoas":[]},{"id":"e3k","t":24662,"idade":29,"texto":"Guilherme foi morar com Aurora.","relevancia":"cotidiano","tema":"familia","tom":"bom","pessoas":["p6"]},{"id":"e3l","t":24662,"idade":29,"texto":"De novo, o irmão, Guilherme, ajudou a fechar as contas: R$ 5.200.","relevancia":"tecnico","tema":"familia","tom":"bom","pessoas":["p6"]},{"id":"e3n","t":24662,"idade":29,"texto":"Caiu no golpe do falso atendente e perdeu R$ 3.455.","relevancia":"biografia","tema":"dinheiro","tom":"ruim","pessoas":[],"escolha":true},{"id":"e3o","t":24674,"idade":30,"texto":"Dengue outra vez — e a segunda foi pior que a primeira.","relevancia":"cotidiano","tema":"saude","tom":"ruim"},{"id":"e3p","t":24674,"idade":30,"texto":"Cinco anos depois, a dívida velha caducou e o nome saiu do cadastro de devedores.","relevancia":"cotidiano","tema":"dinheiro"},{"id":"e3q","t":24674,"idade":30,"texto":"O pai mandou R$ 3.900 \"para ajudar\", sem perguntar muito.","relevancia":"tecnico","tema":"familia","tom":"bom","pessoas":["p2"]},{"id":"e3s","t":24674,"idade":30,"texto":"Esbarrou em Benjamin num velório de um conhecido. Anos sem se ver; conversaram como se tivesse sido ontem, e trocaram telefone.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p12"]},{"id":"e3t","t":24686,"idade":31,"texto":"Sem que ninguém decidisse nada, você e Noah deixaram de se ver.","relevancia":"biografia","tema":"amizade","tom":"ruim","pessoas":["pm"],"evento":{"tipo":"amizade_fim","pessoaId":"pm","peso":25}},{"id":"e3u","t":24686,"idade":31,"texto":"O nome voltou para o cadastro de devedores.","relevancia":"tecnico","tema":"dinheiro","tom":"ruim"},{"id":"e3v","t":24686,"idade":31,"texto":"A mãe cobriu R$ 1.900 do buraco do ano.","relevancia":"tecnico","tema":"familia","tom":"bom","pessoas":["p1"]},{"id":"e3w","t":24686,"idade":31,"texto":"Veio outra recessão: fábricas demitindo, lojas fechando, e as vagas que sobraram pedindo experiência.","relevancia":"biografia","tema":"dinheiro","tom":"ruim","pessoas":[]},{"id":"e3y","t":24686,"idade":31,"texto":"Reencontrou Pietro depois de anos.","relevancia":"biografia","tema":"amizade","pessoas":["p1f"],"escolha":true,"evento":{"tipo":"reencontro","pessoaId":"p1f","peso":20}},{"id":"e3z","t":24698,"idade":32,"texto":"A dor nas costas virou hérnia de disco na ressonância. O plano de saúde cobriu o tratamento.","relevancia":"biografia","tema":"saude","tom":"ruim"},{"id":"e40","t":24698,"idade":32,"texto":"Guilherme e Aurora se separaram. Ele passou uns tempos mal.","relevancia":"biografia","tema":"familia","tom":"ruim","pessoas":["p6"]},{"id":"e41","t":24698,"idade":32,"texto":"De novo, o irmão, Guilherme, ajudou a fechar as contas: R$ 5.900.","relevancia":"tecnico","tema":"familia","tom":"bom","pessoas":["p6"]},{"id":"e42","t":24698,"idade":32,"texto":"O Natal foi na casa de Severino: amigo-secreto, uva-passa no arroz e uma discussão sobre política que ninguém venceu.","relevancia":"cotidiano","tema":"familia","pessoas":["p2"]},{"id":"e44","t":24704,"idade":32,"texto":"Seu tio Gustavo morreu, aos 81 anos (insuficiência renal).","relevancia":"cotidiano","tema":"perda","tom":"ruim","pessoas":["p7"],"evento":{"tipo":"morte","pessoaId":"p7","peso":22}},{"id":"e45","t":24710,"idade":33,"texto":"Você e Benjamin deixaram de combinar coisas. Ninguém percebeu quando.","relevancia":"cotidiano","tema":"amizade","pessoas":["p12"]},{"id":"e46","t":24710,"idade":33,"texto":"O pai mandou R$ 1.900 \"para ajudar\", sem perguntar muito.","relevancia":"tecnico","tema":"familia","tom":"bom","pessoas":["p2"]},{"id":"e47","t":24710,"idade":33,"texto":"Outro assalto, dessa vez dentro do ônibus.","relevancia":"biografia","tema":"lugar","tom":"ruim","pessoas":[]},{"id":"e49","t":24710,"idade":33,"texto":"Aos 33, voltou ao plano de fazer faculdade, feito aos 18.","relevancia":"biogr