,"t":24365,"idade":4,"texto":"Teve medo do escuro, e Fábio passou a deixar um abajur ligado.","relevancia":"cotidiano","tema":"infancia","pessoas":["p2"],"escolha":true},{"id":"eq","t":24377,"idade":5,"texto":"Nasceu seu irmão, Matheus.","relevancia":"marco","tema":"familia","tom":"bom","pessoas":["pp"]},{"id":"et","t":24377,"idade":5,"texto":"Pegou catapora da escola. Duas semanas em casa, coberta de pomada, proibida de coçar.","relevancia":"cotidiano","tema":"saude","pessoas":[]},{"id":"ey","t":24389,"idade":6,"texto":"Primeiro dia no 1º ano da escola do bairro. Fábio levou até o portão; a professora se chamava Dona Célia.","relevancia":"marco","tema":"escola","pessoas":["p2"]},{"id":"e10","t":24389,"idade":6,"texto":"Quebrou o vaso de Juliana e contou na hora.","relevancia":"biografia","tema":"familia","pessoas":["p5"],"escolha":true},{"id":"e12","t":24401,"idade":7,"texto":"Nasceu sua irmã, Vitória.","relevancia":"marco","tema":"familia","tom":"bom","pessoas":["p11"]},{"id":"e15","t":24401,"idade":7,"texto":"Aprendeu a ler no ritmo da turma, juntando sílaba por sílaba no caderno de caligrafia.","relevancia":"biografia","tema":"escola","tom":"neutro","pessoas":[]},{"id":"e18","t":24413,"idade":8,"texto":"Henry virou o amigo de todo dia na escola.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pu"],"evento":{"tipo":"amizade","pessoaId":"pu","peso":20}},{"id":"e1a","t":24425,"idade":9,"texto":"Bento virou o amigo de todo dia na rua de casa.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pm"],"evento":{"tipo":"amizade","pessoaId":"pm","peso":20}},{"id":"e1b","t":24425,"idade":9,"texto":"Maya virou a amiga de todo dia na escola.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pw"],"evento":{"tipo":"amizade","pessoaId":"pw","peso":20}},{"id":"e1d","t":24437,"idade":10,"texto":"Lívia virou a amiga de todo dia na escola.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p13"],"evento":{"tipo":"amizade","pessoaId":"p13","peso":20}},{"id":"e1e","t":24449,"idade":11,"texto":"Repetiu o 5º ano do fundamental.","relevancia":"biografia","tema":"escola","tom":"ruim"},{"id":"e1g","t":24461,"idade":12,"texto":"Repetiu de ano pela segunda vez, agora no 5º ano do fundamental.","relevancia":"biografia","tema":"escola","tom":"ruim"},{"id":"e1i","t":24461,"idade":12,"texto":"Maya passou a ser das pessoas mais próximas da sua vida.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pw"],"evento":{"tipo":"amizade","pessoaId":"pw","peso":35}},{"id":"e1j","t":24461,"idade":12,"texto":"O São João de Recife tomou a cidade por duas semanas: forró até de manhã, milho assado e quadrilha na praça.","relevancia":"cotidiano","tema":"lazer","tom":"bom","pessoas":[]},{"id":"e1q","t":24473,"idade":13,"texto":"Em algum momento, sem aviso, Bento virou a primeira pessoa para quem você liga.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pm"],"evento":{"tipo":"amizade","pessoaId":"pm","peso":35}},{"id":"e1r","t":24473,"idade":13,"texto":"O boletim veio com notas vermelhas. Fábio foi chamado na escola para uma conversa com a coordenação.","relevancia":"cotidiano","tema":"escola","tom":"ruim","pessoas":["p2"]},{"id":"e1t","t":24485,"idade":14,"texto":"Seu avô Genésio ficou internado por uns dias. Voltou para casa mais devagar.","relevancia":"cotidiano","tema":"familia","tom":"ruim","pessoas":["p6"]},{"id":"e1x","t":24497,"idade":15,"texto":"Nasceu sua irmã, Beatriz.","relevancia":"marco","tema":"familia","tom":"bom","pessoas":["p1w"]},{"id":"e22","t":24497,"idade":15,"texto":"Começou a sair com Rodrigo.","relevancia":"biografia","tema":"amor","tom":"bom","pessoas":["p1v"],"escolha":true},{"id":"e23","t":24498,"idade":15,"texto":"Seu avô Genésio morreu, aos 79 anos (infarto).","relevancia":"marco","tema":"perda","tom":"ruim","pessoas":["p6"],"evento":{"tipo":"morte","pessoaId":"p6","peso":40}},{"id":"e24","t":24509,"idade":16,"texto":"Na rua de casa, Augusto deixou de ser só colega e virou amigo.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p1c"],"evento":{"tipo":"amizade","pessoaId":"p1c","peso":20}},{"id":"e25","t":24509,"idade":16,"texto":"Você e Ana Clara foram se perdendo de vista.","relevancia":"cotidiano","tema":"amizade","pessoas":["p17"]},{"id":"e27","t":24521,"idade":17,"texto":"3ª reprovação: o 9º ano do fundamental de novo, com colegas cada vez mais novos.","relevancia":"biografia","tema":"escola","tom":"ruim"},{"id":"e28","t":24521,"idade":17,"texto":"As saídas com Rodrigo foram rareando até pararem.","relevancia":"cotidiano","tema":"amor","pessoas":["p1v"]},{"id":"e2b","t":24521,"idade":17,"texto":"Chamou Anthony para sair e levou um não educado.","relevancia":"biografia","tema":"amor","tom":"ruim","pessoas":["p1y"],"escolha":true},{"id":"e2c","t":24533,"idade":18,"texto":"Terminou o fundamental e começou o ensino médio na escola estadual do bairro.","relevancia":"biografia","tema":"escola"},{"id":"e2i","t":24533,"idade":18,"texto":"Levaram seu celular num assalto rápido, à luz do dia, numa esquina movimentada.","relevancia":"biografia","tema":"lugar","tom":"ruim","pessoas":[]},{"id":"e2j","t":24533,"idade":18,"texto":"Alistou-se voluntariamente, mas não foi selecionada para o serviço militar.","relevancia":"biografia","tema":"lugar","pessoas":[],"escolha":true},{"id":"e2k","t":24545,"idade":19,"texto":"Ficou de recuperação em matemática, e passou raspando.","relevancia":"cotidiano","tema":"escola","tom":"ruim"},{"id":"e2n","t":24545,"idade":19,"texto":"Lorenzo, que você conheceu na escola, virou amigo de verdade.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p1l"],"evento":{"tipo":"amizade","pessoaId":"p1l","peso":20}},{"id":"e2o","t":24545,"idade":19,"texto":"As mensagens com Henry foram ficando mais espaçadas, até pararem.","relevancia":"cotidiano","tema":"amizade","pessoas":["pu"]},{"id":"e2p","t":24545,"idade":19,"texto":"A mãe cobriu R$ 1.500 do buraco do ano.","relevancia":"cotidiano","tema":"familia","tom":"bom","pessoas":["p1"]},{"id":"e2r","t":24545,"idade":19,"texto":"Caiu no golpe do falso atendente e perdeu R$ 1.500.","relevancia":"biografia","tema":"dinheiro","tom":"ruim","pessoas":[],"escolha":true},{"id":"e2u","t":24557,"idade":20,"texto":"Lívia virou alguém de quem você lembra no aniversário, e só.","relevancia":"cotidiano","tema":"amizade","pessoas":["p13"]},{"id":"e2v","t":24557,"idade":20,"texto":"A amizade com Augusto ficou para trás, sem briga nenhuma.","relevancia":"cotidiano","tema":"amizade","pessoas":["p1c"]},{"id":"e2y","t":24557,"idade":20,"texto":"O São João de Recife tomou a cidade por duas semanas: forró até de manhã, milho assado e quadrilha na praça.","relevancia":"cotidiano","tema":"lazer","tom":"bom","pessoas":[]},{"id":"e2z","t":24557,"idade":20,"texto":"Chamou Ryan para sair e levou um não educado.","relevancia":"biografia","tema":"amor","tom":"ruim","pessoas":["p2f"],"escolha":true},{"id":"e30","t":24567,"idade":20,"texto":"Sua avó Iracema morreu, aos 78 anos (AVC).","relevancia":"marco","tema":"perda","tom":"ruim","pessoas":["p3"],"evento":{"tipo":"morte","pessoaId":"p3","peso":45}},{"id":"e31","t":24569,"idade":21,"texto":"Concluiu o ensino médio, com 3 repetências no caminho.","relevancia":"marco","tema":"escola","tom":"bom"},{"id":"e33","t":24593,"idade":23,"texto":"Você e Lorenzo deixaram de combinar coisas. Ninguém percebeu quando.","relevancia":"cotidiano","tema":"amizade","pessoas":["p1l"]},{"id":"e35","t":24593,"idade":23,"texto":"O país entrou em recessão: fábricas demitindo, lojas fechando, e as vagas que sobraram pedindo experiência.","relevancia":"biografia","tema":"dinheiro","tom":"ruim","pessoas":[]},{"id":"e36","t":24605,"idade":24,"texto":"A crise foi passando sem aviso: o shopping encheu de novo, as obras paradas voltaram a ter barulho.","relevancia":"cotidiano","tema":"dinheiro","pessoas":[]},{"id":"e37","t":24605,"idade":24,"texto":"O almoço de Páscoa juntou a família toda pela primeira vez em anos, na casa de Matheus.","relevancia":"cotidiano","tema":"familia","pessoas":["pp"]},{"id":"e3a","t":24617,"idade":25,"texto":"De novo, a mãe ajudou a fechar as contas: R$ 300.","relevancia":"cotidiano","tema":"familia","tom":"bom","pessoas":["p1"]},{"id":"e3b","t":24617,"idade":25,"texto":"Saiu o edital para técnica administrativa concursada. Os grupos de estudo lotaram.","relevancia":"cotidiano","tema":"trabalho","pessoas":[]},{"id":"e3d","t":24641,"idade":27,"texto":"Matheus saiu de casa. O quarto ficou vazio.","relevancia":"cotidiano","tema":"familia","pessoas":["pp"]},{"id":"e3e","t":24641,"idade":27,"texto":"Sem que ninguém decidisse nada, você e Maya deixaram de se ver.","relevancia":"biografia","tema":"amizade","tom":"ruim","pessoas":["pw"],"evento":{"tipo":"amizade_fim","pessoaId":"pw","peso":25}},{"id":"e3f","t":24641,"idade":27,"texto":"Esbarrou em Lorenzo numa festa de aniversário. Anos sem se ver; conversaram como se tivesse sido ontem, e trocaram telefone.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p1l"]},{"id":"e3i","t":24653,"idade":28,"texto":"Matheus casou com Stella.","relevancia":"cotidiano","tema":"familia","tom":"bom","pessoas":["pp"]},{"id":"e3j","t":24653,"idade":28,"texto":"Bento teve um filho. As mensagens no grupo passaram a ser fotos de bebê.","relevancia":"cotidiano","tema":"amizade","pessoas":["pm"]},{"id":"e3k","t":24665,"idade":29,"texto":"Sua avó Juliana ficou internada por uns dias. Voltou para casa mais devagar.","relevancia":"cotidiano","tema":"familia","tom":"ruim","pessoas":["p5"]},{"id":"e3l","t":24665,"idade":29,"texto":"Vitória saiu de casa. O quarto ficou vazio.","relevancia":"cotidiano","tema":"familia","pessoas":["p11"]},{"id":"e3m","t":24665,"idade":29,"texto":"Lorenzo se mudou para João Pessoa. A amizade passou a caber no celular.","relevancia":"cotidiano","tema":"amizade","pessoas":["p1l"]},{"id":"e3n","t":24665,"idade":29,"texto":"Você e Lorenzo foram se perdendo de vista.","relevancia":"cotidiano","tema":"amizade","pessoas":["p1l"]},{"id":"e3p","t":24672,"idade":29,"texto":"Sua avó Juliana morreu, aos 83 anos (câncer).","relevancia":"marco","tema":"perda","tom":"ruim","pessoas":["p5"],"evento":{"tipo":"morte","pessoaId":"p5","peso":47}},{"id":"e3r","t":24677,"idade":30,"texto":"O país voltou a entrar em recessão: fábricas demitindo, lojas fechando, e as vagas que sobraram pedindo experiência.","relevancia":"biografia","tema":"dinheiro","tom":"ruim","pessoas":[]},{"id":"e3t","t":24677,"idade":30,"texto":"Reencontrou Maya depois de anos.","relevancia":"biografia","tema":"amizade","pessoas":["pw"],"escolha":true,"evento":{"tipo":"reencontro","pessoaId":"pw","peso":20}},{"id":"e3u","t":24680,"idade":30,"texto":"Seu avô Márcio morreu, aos 77 anos (pneumonia).","relevancia":"marco","tema":"perda","tom":"ruim","pessoas":["p4"],"evento":{"tipo":"morte","pessoaId":"p4","peso":48}},{"id":"e3v","t":24689,"idade":31,"texto":"A crise foi passando sem aviso: o shopping encheu de novo, as obras paradas voltaram a ter barulho.","relevancia":"cotidiano","tema":"dinheiro","pessoas":[]},{"id":"e3w","t":24689,"idade":31,"texto":"Uma tempestade parou Recife: avenidas alagadas, ônibus parados, gente dormindo no trabalho.","relevancia":"cotidiano","tema":"lugar","pessoas":[]},{"id":"e3x","t":24701,"idade":32,"texto":"A vida puxou você e Bento para lados diferentes.","relevancia":"biografia","tema":"amizade","tom":"ruim","pessoas":["pm"],"evento":{"tipo":"amizade_fim","pessoaId":"pm","peso":25}},{"id":"e3y","t":24713,"idade":33,"texto":"Uma medição de pressão num posto de saúde deu alta. O médico falou em remédio para o resto da vida. Tratar ia depender de fila no SUS ou de pagar do bolso.","relevancia":"biografia","tema":"saude","tom":"ruim"},{"id":"e43","t":24713,"idade":33,"texto":"O São João de Recife tomou a cidade por duas semanas: forró até de manhã, milho assado e quadrilha na praça.","relevancia":"cotidiano","tema":"lazer","tom":"bom","pes