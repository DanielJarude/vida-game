 para qualquer outra pessoa.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["px"],"evento":{"tipo":"amizade","pessoaId":"px","peso":35}},{"id":"e26","t":24486,"idade":14,"texto":"A família de Cauã se mudou para outra cidade. A despedida foi no portão da escola.","relevancia":"biografia","tema":"amizade","tom":"ruim","pessoas":["pw"]},{"id":"e28","t":24486,"idade":14,"texto":"Foi ao show com Nicolas.","relevancia":"biografia","tema":"lazer","pessoas":["px","p1"],"escolha":true},{"id":"e29","t":24498,"idade":15,"texto":"Morreu Lucca.","relevancia":"tecnico","tema":"perda","pessoas":["p1p"],"evento":{"tipo":"morte","pessoaId":"p1p","peso":7}},{"id":"e2a","t":24498,"idade":15,"texto":"Terminou o fundamental e começou o ensino médio na escola estadual do bairro.","relevancia":"biografia","tema":"escola"},{"id":"e2i","t":24498,"idade":15,"texto":"O país entrou em recessão. Em casa, a palavra apareceu no jornal da noite e depois na conta do mercado.","relevancia":"biografia","tema":"dinheiro","tom":"ruim","pessoas":[]}],"momento":null,"ocorrencias":[{"id":"bb_primeiros_passos","t":24330,"idade":1},{"id":"bb_noites_sem_dormir","t":24330,"idade":1},{"id":"bb_primeira_palavra","t":24342,"idade":2},{"id":"pri_casa_avo","t":24354,"idade":3},{"id":"inf_primeiro_dia_aula","t":24390,"idade":6},{"id":"inf_alfabetizacao","t":24402,"idade":7},{"id":"inf_avo_ensina","t":24402,"idade":7},{"id":"prc_vaso_quebrado","t":24402,"idade":7},{"id":"inf_colar_prova","t":24426,"idade":9},{"id":"ado_excursao","t":24450,"idade":11},{"id":"inf_bullying","t":24450,"idade":11},{"id":"inf_enchente","t":24462,"idade":12},{"id":"inf_amigo_muda","t":24486,"idade":14},{"id":"ado_show","t":24486,"idade":14},{"id":"mun_recessao","t":24498,"idade":15}],"anoAtual":{"acoes":[]},"luto":[]}