:"ed","t":24329,"idade":1,"texto":"Os primeiros passos vieram tarde, depois de muito tempo engatinhando — e vieram de uma vez: atravessou a cozinha sem cair.","relevancia":"marco","tema":"infancia","tom":"bom","pessoas":["p2"]},{"id":"ee","t":24329,"idade":1,"texto":"O avô Severino passou a aparecer toda semana, sempre com alguma coisa no bolso para dar escondido.","relevancia":"cotidiano","tema":"familia","pessoas":["p4"]},{"id":"ef","t":24341,"idade":2,"texto":"Começou a ir para a creche municipal.","relevancia":"cotidiano","tema":"escola"},{"id":"ej","t":24341,"idade":2,"texto":"A primeira palavra foi \"não\". A família riu e disse que era um sinal.","relevancia":"marco","tema":"infancia","pessoas":["p2"],"escolha":true},{"id":"el","t":24353,"idade":3,"texto":"A primeira vez na praia foi num domingo de sol, com isopor, farofa e Ricardo segurando sua mão na beira da água.","relevancia":"biografia","tema":"infancia","tom":"bom","pessoas":["p2"]},{"id":"em","t":24365,"idade":4,"texto":"Entrou na pré-escola, na escola municipal do bairro.","relevancia":"cotidiano","tema":"escola"},{"id":"er","t":24377,"idade":5,"texto":"Ana Clara virou a amiga de todo dia na escolinha.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pg"],"evento":{"tipo":"amizade","pessoaId":"pg","peso":20}},{"id":"es","t":24377,"idade":5,"texto":"As férias foram na casa de um primo: Lucca, colchão no chão e televisão até tarde.","relevancia":"cotidiano","tema":"familia","pessoas":["pa"]},{"id":"ey","t":24389,"idade":6,"texto":"Liz virou a amiga de todo dia na rua de casa.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["po"],"evento":{"tipo":"amizade","pessoaId":"po","peso":20}},{"id":"ez","t":24389,"idade":6,"texto":"Primeiro dia no 1º ano da escola do bairro. Thaís levou até o portão; a professora se chamava Professora Márcia.","relevancia":"marco","tema":"escola","pessoas":["p1"]},{"id":"e10","t":24389,"idade":6,"texto":"Thaís apareceu com uma bicicleta usada, reformada com peças de outra. Tirou as rodinhas na rua de casa numa tarde de domingo.","relevancia":"biografia","tema":"infancia","tom":"bom","pessoas":["p1"]},{"id":"e12","t":24389,"idade":6,"texto":"Saiu no tapa com Enzo por causa de uma coisa estragada.","relevancia":"biografia","tema":"familia","pessoas":["p7"],"escolha":true},{"id":"e16","t":24401,"idade":7,"texto":"A leitura demorou a engrenar. A professora mandou bilhete pedindo reforço em casa.","relevancia":"biografia","tema":"escola","tom":"ruim","pessoas":[]},{"id":"e1b","t":24413,"idade":8,"texto":"Olívia virou a amiga de todo dia na rua de casa.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pq"],"evento":{"tipo":"amizade","pessoaId":"pq","peso":20}},{"id":"e1d","t":24413,"idade":8,"texto":"Chamou Rebeca, que estava sozinha no primeiro dia, para brincar.","relevancia":"biografia","tema":"amizade","pessoas":["pw"],"escolha":true},{"id":"e1f","t":24425,"idade":9,"texto":"Liz passou a ser das pessoas mais próximas da sua vida.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["po"],"evento":{"tipo":"amizade","pessoaId":"po","peso":35}},{"id":"e1g","t":24425,"idade":9,"texto":"Rebeca virou a amiga de todo dia na escola.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["pw"],"evento":{"tipo":"amizade","pessoaId":"pw","peso":20}},{"id":"e1i","t":24437,"idade":10,"texto":"Maria Alice virou a amiga de todo dia na rua de casa.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p15"],"evento":{"tipo":"amizade","pessoaId":"p15","peso":20}},{"id":"e1j","t":24437,"idade":10,"texto":"Pegou catapora da escola. Duas semanas em casa, coberto de pomada, proibido de coçar.","relevancia":"cotidiano","tema":"saude","pessoas":[]},{"id":"e1k","t":24449,"idade":11,"texto":"Sua mãe perdeu o emprego de confeiteira. O dinheiro em casa encurtou.","relevancia":"biografia","tema":"familia","tom":"ruim","pessoas":["p1"]},{"id":"e1q","t":24449,"idade":11,"texto":"A família de Olívia se mudou para outra cidade. A despedida foi no portão da escola.","relevancia":"biografia","tema":"amizade","tom":"ruim","pessoas":["pq"]},{"id":"e1r","t":24461,"idade":12,"texto":"Sua mãe arrumou trabalho de novo, como confeiteira.","relevancia":"cotidiano","tema":"familia","pessoas":["p1"]},{"id":"e1v","t":24461,"idade":12,"texto":"Na rua de casa, Maya deixou de ser só colega e virou amiga.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p1a"],"evento":{"tipo":"amizade","pessoaId":"p1a","peso":20}},{"id":"e1z","t":24473,"idade":13,"texto":"Em algum momento, sem aviso, Maria Alice virou a primeira pessoa para quem você liga.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p15"],"evento":{"tipo":"amizade","pessoaId":"p15","peso":35}},{"id":"e20","t":24473,"idade":13,"texto":"Uma tempestade parou Recife: avenidas alagadas, ônibus parados, gente dormindo no trabalho.","relevancia":"cotidiano","tema":"lugar","pessoas":[]},{"id":"e22","t":24485,"idade":14,"texto":"Enzo saiu de casa. O quarto ficou vazio.","relevancia":"cotidiano","tema":"familia","pessoas":["p7"]},{"id":"e24","t":24485,"idade":14,"texto":"Vitória, da sua turma, engravidou aos 13 e parou de ir à escola no segundo semestre.","relevancia":"cotidiano","tema":"escola","pessoas":["p1m"]},{"id":"e26","t":24485,"idade":14,"texto":"Brigou com Valentina na saída da escola e foi suspenso.","relevancia":"biografia","tema":"escola","pessoas":["p1x"],"escolha":true},{"id":"e27","t":24497,"idade":15,"texto":"Terminou o fundamental e começou o ensino médio na escola estadual do bairro.","relevancia":"biografia","tema":"escola"},{"id":"e2c","t":24497,"idade":15,"texto":"O país entrou em recessão. Em casa, a palavra apareceu no jornal da noite e depois na conta do mercado.","relevancia":"biografia","tema":"dinheiro","tom":"ruim","pessoas":[]},{"id":"e2d","t":24497,"idade":15,"texto":"Uma chuva de verão alagou a rua e a água entrou em casa. O sofá e a geladeira foram para o lixo.","relevancia":"biografia","tema":"lugar","tom":"ruim","pessoas":[]},{"id":"e2g","t":24509,"idade":16,"texto":"Maya já sabia das coisas antes de você contar para qualquer outra pessoa.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p1a"],"evento":{"tipo":"amizade","pessoaId":"p1a","peso":35}},{"id":"e2h","t":24509,"idade":16,"texto":"Na rua de casa, Maitê deixou de ser só colega e virou amiga.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p1h"],"evento":{"tipo":"amizade","pessoaId":"p1h","peso":20}},{"id":"e2j","t":24509,"idade":16,"texto":"A economia voltou a respirar. Os anúncios de vaga reapareceram nos postes.","relevancia":"cotidiano","tema":"dinheiro","pessoas":[]},{"id":"e2k","t":24509,"idade":16,"texto":"Foi assaltado no ponto de ônibus voltando da escola. Levaram o celular.","relevancia":"biografia","tema":"lugar","tom":"ruim","pessoas":[]},{"id":"e2n","t":24521,"idade":17,"texto":"Pedro casou com Heloísa.","relevancia":"cotidiano","tema":"familia","tom":"bom","pessoas":["p6"]},{"id":"e2q","t":24521,"idade":17,"texto":"No ensino médio, Emanuelly deixou de ser só colega e virou amiga.","relevancia":"biografia","tema":"amizade","tom":"bom","pessoas":["p2b"],"evento":{"tipo":"amizade","pessoaId":"p2b","peso":20}},{"id":"e2r","t":24530,"idade":17,"texto":"Sua avó Dalva morreu, aos 80 anos (infarto).","relevancia":"marco","tema":"perda","tom":"ruim","pessoas":["p5"],"evento":{"tipo":"morte","pessoaId":"p5","peso":41}},{"id":"e2s","t":24533,"idade":18,"texto":"Seu pai perdeu o emprego de auxiliar de cozinha. O dinheiro em casa encurtou.","relevancia":"biografia","tema":"familia","tom":"ruim","pessoas":["p2"]},{"id":"e2t","t":24533,"idade":18,"texto":"Concluiu o ensino médio.","relevancia":"marco","tema":"escola","tom":"bom"},{"id":"e2v","t":24533,"idade":18,"texto":"Fez o ENEM pela primeira vez e tirou 513 — uma nota baixa.","relevancia":"biografia","tema":"estudo","tom":"neutro","escolha":true},{"id":"e2w","t":24545,"idade":19,"texto":"Seu pai arrumou trabalho de novo, como auxiliar de cozinha.","relevancia":"cotidiano","tema":"familia","pessoas":["p2"]},{"id":"e2x","t":24545,"idade":19,"texto":"Maria Alice se mudou para Belo Horizonte. A amizade passou a caber no celular.","relevancia":"biografia","tema":"amizade","pessoas":["p15"]},{"id":"e2y","t":24545,"idade":19,"texto":"Passou o Ano-Novo com a família de Thaís, na praia, todo mundo de branco num apartamento alugado para doze.","relevancia":"cotidiano","tema":"familia","pessoas":["p1"]},{"id":"e2z","t":24557,"idade":20,"texto":"Pedro e Heloísa se separaram. Ele passou uns tempos mal.","relevancia":"biografia","tema":"familia","tom":"ruim","pessoas":["p6"]},{"id":"e30","t":24557,"idade":20,"texto":"Você e Maitê foram se perdendo de vista.","relevancia":"cotidiano","tema":"amizade","pessoas":["p1h"]},{"id":"e31","t":24557,"idade":20,"texto":"O São João de Recife tomou a cidade por duas semanas: forró até de manhã, milho assado e quadrilha na praça.","relevancia":"cotidiano","tema":"lazer","tom":"bom","pessoas":[]},{"id":"e33","t":24557,"idade":20,"texto":"Começou a sair com Emanuelly.","relevancia":"biografia","tema":"amor","tom":"bom","pessoas":["p2b"],"escolha":true},{"id":"e35","t":24569,"idade":21,"texto":"Liz se formou. Você gritou o nome dela da plateia.","relevancia":"cotidiano","tema":"amizade","pessoas":["po"]},{"id":"e37","t":24569,"idade":21,"texto":"Começou a namorar Emanuelly.","relevancia":"marco","tema":"amor","tom":"bom","pessoas":["p2b"],"escolha":true},{"id":"e38","t":24581,"idade":22,"texto":"A família de Emanuelly entrou em crise, e ela passou meses indo e voltando da casa dos pais.","relevancia":"cotidiano","tema":"amor","tom":"ruim","pessoas":["p2b"]},{"id":"e39","t":24593,"idade":23,"texto":"Pedro saiu de casa. O quarto ficou vazio.","relevancia":"cotidiano","tema":"familia","pessoas":["p6"]},{"id":"e3b","t":24593,"idade":23,"texto":"Uma tempestade parou Recife: avenidas alagadas, ônibus parados, gente dormindo no trabalho.","relevancia":"cotidiano","tema":"lugar","pessoas":[]},{"id":"e3d","t":24605,"idade":24,"texto":"Pedro casou com Marina.","relevancia":"cotidiano","tema":"familia","tom":"bom","pessoas":["p6"]},{"id":"e3f","t":24605,"idade":24,"texto":"Enzo foi morar com Helena.","relevancia":"cotidiano","tema":"familia","tom":"bom","pessoas":["p7"]},{"id":"e3g","t":24605,"idade":24,"texto":"Emanuelly atravessou uma fase difícil: ela ficou calada, distante, com a cabeça longe.","relevancia":"cotidiano","tema":"amor","tom":"ruim","pessoas":["p2b"]},{"id":"e3j","t":24617,"idade":25,"texto":"Pedro e Marina se separaram. Ele passou uns tempos mal.","relevancia":"biografia","tema":"familia","tom":"ruim","pessoas":["p6"]},{"id":"e3k","t":24617,"idade":25,"texto":"Saiu o edital para técnico administrativo concursado. Os grupos de estudo lotaram.","relevancia":"cotidiano","tema":"trabalho","pessoas":[]},{"id":"e3n","t":24629,"idade":26,"texto":"Decidiu com Emanuelly tentar ter um filho.","relevancia":"biografia","tema":"filhos","pessoas":["p2b"],"escolha":true},{"id":"e3s","t":24641,"idade":27,"texto":"A distância fez o que a distância faz: você e Maria Alice deixaram de ser próximos.","relevancia":"biografia","tema":"amizade","tom":"ruim","pessoas":["p15"],"evento":{"tipo":"amizade_fim","pessoaId":"p15","peso":25}},{"id":"e3u","t":24633,"idade":26,"texto":"Emanuelly está grávida. Depois de meses tentando, o teste deu positivo.","relevancia":"marco","tema":"filhos","tom":"bom","pessoas":["p2b"],"evento":{"tipo":"gravidez","pessoaId":"p2b","peso":50}},{"id":"e3y","t":24640,"idade":26,"texto":"Em maio, nasceu Bianca. Pai pela primeira vez, aos 27.","relevancia":"marco","tema":"filhos","tom":"bom","pessoas":["p3v","p2b"],"evento":{"tipo":"filho_nasceu","pessoaId":"p3v","peso":80}}],"momento":null,"ocorrencias":[{"id":"bb_primeiros_passos","t":24329,"idade":1},{"id":"bb_visita_avos","t":24329,"idade":1},{"id":"bb_primeira_palavra","t":24341,"idade":2},{"id":"pri_pr